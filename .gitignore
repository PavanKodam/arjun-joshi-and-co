# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo/
.cache/

# production
/build
/dist/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.bak
*.tmp
*.temp
*.pid

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# environment files - never commit real credentials
.env
.env.*
*.env
*.env.*
.envrc

# allow the placeholder-only template (never put real values in it)
!.env.example

# stray file created by mistake, do not commit
\!.env.example

# certificates and private keys
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der

# registry and credential files
.npmrc
.yarnrc.yml
.pypirc
.netrc
_netrc
.git-credentials

# hosting and deployment metadata
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# editors and local history
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.history/
*.swp
*.swo
*~
