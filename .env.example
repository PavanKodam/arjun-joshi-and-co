# ---------------------------------------------------------------------------
# Placeholder-only template. NEVER put real keys or passwords in this file.
# Copy these values into `.env.local` (which is ignored by Git) and fill them in.
# ---------------------------------------------------------------------------

# Resend API key. Create one at https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=

# Where new enquiry notifications are sent. Separate multiple addresses with commas.
ENQUIRY_TO_EMAIL=

# Verified sender address in Resend, e.g. "Arjun Joshi & Co. <enquiries@yourdomain.com>"
RESEND_FROM_EMAIL=

# Set to "true" only after the sending domain is verified in Resend.
SEND_CUSTOMER_CONFIRMATION=false

# Public site address, e.g. https://arjunjoshiandco.com
NEXT_PUBLIC_SITE_URL=

# WhatsApp number in international format, digits only (e.g. 918805966666).
NEXT_PUBLIC_WHATSAPP_NUMBER=
